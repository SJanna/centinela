{
  "name": "agente-pagos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dataset:generate": "tsx dataset/generator/generate.ts",
    "dataset:extend": "tsx dataset/generator/extend.ts",
    "eval": "tsx eval/run.ts --reader=simulated",
    "eval:cache": "tsx eval/run.ts --reader=cache",
    "eval:live": "tsx eval/run.ts --reader=live",
    "stress:generate": "tsx dataset/stress/build-stress.ts",
    "eval:stress": "tsx eval/run.ts --dataset=stress --reader=simulated --concurrency=8",
    "eval:stress:live": "tsx eval/run.ts --dataset=stress --reader=live --concurrency=4",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@electric-sql/pglite": "^0.5.10",
    "@neondatabase/serverless": "^1.2.0",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.58.0",
    "mailparser": "^3.9.40",
    "motion": "^14.3.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "^1.7.0",
    "zod": "^4.6.7",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "pdfkit": "^0.20.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.18"
  }
}

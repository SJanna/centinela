# Copia este archivo como .env.local y completa lo que necesites. Ninguna variable es obligatoria
# para probar en local: sin ellas, la lectura es simulada y la base es PGlite en .data/pglite.

# Clave de la API de Anthropic. Con ella (y READING_MODE=auto) las facturas se leen con
# claude-sonnet-5-5 y claude-haiku-5-5. Cada lectura nueva cuesta dinero; las repetidas salen de la caché.
# También la usa `npm run eval:live`.
ANTHROPIC_API_KEY=

# Modo de lectura: live | simulated | auto (por defecto auto).
#   auto       → live si hay ANTHROPIC_API_KEY; si no, simulated.
#   simulated  → lectura «perfecta» de las facturas de ejemplo (dataset/generated); cualquier otro
#                archivo escala por LEC-1. Sirve para probar la lógica sin costo.
READING_MODE=auto

# Postgres (Neon) para producción. Si está vacía se usa PGlite local.
DATABASE_URL=

# Código de acceso a la demo. Si se define, las páginas piden el código en /acceso y la API
# responde 401 sin la cookie de acceso. Vacío = todo abierto (desarrollo local).
DEMO_ACCESS_CODE=

# Carpeta de datos de PGlite cuando no hay DATABASE_URL (por defecto .data/pglite).
# «memory» usa una base en memoria que se pierde al reiniciar.
PGLITE_DIR=

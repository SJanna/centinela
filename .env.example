# Copia este archivo como .env.local y completa lo que necesites. Ninguna variable es obligatoria
# para probar en local: sin ellas, la lectura es simulada y la base es PGlite en .data/pglite.

# Clave de la API de Anthropic. Con ella (y READING_MODE=auto) cada factura se lee dos veces con los
# modelos de READER_PROFILE. Cada lectura nueva cuesta dinero; las repetidas salen de la caché.
# También la usa `npm run eval:live`.
ANTHROPIC_API_KEY=

# Perfil de las dos lecturas en vivo: economico | calidad (por defecto economico).
#   economico → claude-haiku-5-5 con el prompt «a» (v3) + claude-haiku-5-5 con el prompt «b» (v3b).
#               El prompt «b» es otra formulación (auditor que transcribe primero y luego interpreta,
#               campos en otro orden) para que las dos lecturas no repitan los mismos errores.
#   calidad   → claude-sonnet-5-5 + claude-haiku-5-5, los dos con el prompt «a» (comportamiento anterior;
#               reutiliza las lecturas ya guardadas en la caché). Cuesta más.
# Ambos con esfuerzo low. Un valor desconocido cuenta como economico. Cambiar de perfil no borra la
# caché: cada lectura se guarda con su modelo y su versión de prompt.
READER_PROFILE=economico

# Modo de lectura: live | simulated | auto (por defecto auto).
#   auto       → live si hay ANTHROPIC_API_KEY; si no, simulated.
#   simulated  → lectura «perfecta» de las facturas de ejemplo (dataset/generated); cualquier otro
#                archivo escala por LEC-1. Sirve para probar la lógica sin costo.
READING_MODE=auto

# Postgres (Neon) para producción. Si está vacía se usa PGlite local.
DATABASE_URL=

# Código de acceso a la demo. Si se define, las páginas piden el código en /acceso y la API
# responde 401 sin la cookie de acceso. Vacío = todo abierto (desarrollo local).
DEMO_ACCESS_CODE=

# Carpeta de datos de PGlite cuando no hay DATABASE_URL (por defecto .data/pglite).
# «memory» usa una base en memoria que se pierde al reiniciar.
PGLITE_DIR=
